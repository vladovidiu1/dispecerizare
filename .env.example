# Local development only; copy to .env and fill in your own values.
POSTGRES_PASSWORD=
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://relay:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/relay
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
# true connects the UI to the API; false/unset preserves the original demo.
VITE_API_ENABLED=true
# Bootstrap once; remove the password from this file after successful bootstrap.
ORGANIZATION_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Tests use an isolated temporary schema, never public tables.
TEST_DATABASE_URL=
# Dispatch uses administrator rules; no AI runtime is required.
# Optional directory for the private mail credential encryption key.
# Default: .relay in the backend working directory. Keep private and back it up.
# RELAY_DATA_DIR=D:/Relay-private-data
# Additional exact browser origins for LAN testing (no wildcards).
# APP_ORIGINS=http://192.168.1.50:5173,http://relay-pc:5173
# Compiled local UI + API: npm run build, then npm run start:local.
# Set HOST=0.0.0.0 and APP_ORIGIN=http://relay-pc:3001 for LAN HTTP tests.
# Keep PostgreSQL listening only on loopback.
