# Copy to .relay/https.env. Keep existing database/email settings in .env.
# Replace this example with a stable internal DNS name approved by IT.
APP_ORIGIN=https://relay.example.test
APP_ORIGINS=
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
TRUST_PROXY_HOPS=1
# PEM certificate including intermediate chain, and corresponding PEM private key.
# Use absolute paths, forward slashes on Windows, and quotes around paths with spaces.
RELAY_TLS_CERT_FILE=C:/Relay-private/tls/fullchain.pem
RELAY_TLS_KEY_FILE=C:/Relay-private/tls/private.key
CADDY_EXE=C:/Tools/Caddy/caddy.exe
