# Local development only; copy to .env and fill in your own values.
POSTGRES_PASSWORD=
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://relay:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/relay
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
# true connects the UI to the API; false/unset preserves the original demo.
VITE_API_ENABLED=true
# Bootstrap once; remove the password from this file after successful bootstrap.
ORGANIZATION_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Tests use an isolated temporary schema, never public tables.
TEST_DATABASE_URL=
# Local Ollama, on the same computer as the backend.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=300000
